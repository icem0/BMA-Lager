# bma-lager Caddyfile
#
# Reverse-Proxy: alles unter /api/* und /fotos/* geht an die API,
# der Rest zur PWA.
#
# In Produktion (mit Cloudflare-Tunnel): KEIN TLS offload hier — der Tunnel
# erwartet HTTP-Backend. In einer Variante ohne Tunnel (Ports 80/443 am Host)
# wird Caddy selbst TLS (Let's Encrypt) ausstellen.

{
    # Global: Logging, Admin
    admin off
    default_bind 0.0.0.0
}

:80 {
    # API
    reverse_proxy /api/* api:3000

    # Fotos (statisch aus dem API-Volume-Serve)
    reverse_proxy /fotos/* api:3000

    # Health-Checks
    respond /healthz "ok" 200

    # Alles andere → PWA (SPA)
    reverse_proxy pwa:80

    encode zstd gzip

    log {
        output stdout
        level INFO
    }
}