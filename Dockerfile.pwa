# Multi-Stage Build für die PWA (Vue 3 + Vite).
# Output: statische Dateien in /usr/share/nginx/html

# ---------- Build ----------
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY tsconfig*.json vite.config.ts index.html ./
COPY public ./public
COPY src ./src
COPY scripts ./scripts
RUN npm run build

# ---------- Runtime ----------
FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
# nginx-Konfig: SPA-Routing (alles auf index.html), Healthz, Cache-Headers
COPY nginx-pwa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]