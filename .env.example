# bma-lager — Production Environment
# Diese Datei kopieren nach `.env` und ausfüllen, NIE einchecken.

# GitHub-Owner (für GHCR-Pulls). Beispiel: "dein-username".
GITHUB_REPOSITORY_OWNER=

# ---------- Datenbank ----------
DB_NAME=bma
DB_USER=bma
# Starkes Passwort, mind. 16 Zeichen, generiert z. B. mit `openssl rand -base64 24`
DB_PASSWORD=

# ---------- Auth ----------
# JWT_SECRET: mindestens 64 Zeichen, z. B. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD: muss beim ersten Login geändert werden (mustChangePassword=true)
ADMIN_PASSWORD=

# Cookie-Domain für Refresh-Cookies (ohne Protokoll)
COOKIE_DOMAIN=bma-lager.example.com

# CORS-Origin der PWA (wo der Browser tatsächlich laeuft)
CORS_ORIGIN=https://bma-lager.example.com

# ---------- Foto-Limits ----------
FOTOS_MAX_BYTES=524288       # 512 kB pro Datei
FOTOS_MAX_PER_ARTIKEL=5

# ---------- Rate-Limit ----------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=1 minute

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Cloudflare-Tunnel ----------
# Aus Cloudflare Zero Trust → Networks → Tunnels → dein Tunnel → Configure
# → Token kopieren.
CLOUDFLARE_TUNNEL_TOKEN=