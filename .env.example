# bma-lager — Production Environment
# Diese Datei kopieren nach `.env` und ausfüllen, NIE einchecken.

# ---------- Image-Repo ----------
# Basis-Pfad für alle Docker-Images. Default zeigt auf das offizielle
# Upstream-Repo (ghcr.io/icem0/bma-lager). Wenn du eigene Images baust,
# setze hier deinen Pfad, z. B. BMA_IMAGE_REPO=ghcr.io/dein-user/bma-lager
# oder BMA_IMAGE_REPO=registry.example.com/mein-team/bma-lager.
BMA_IMAGE_REPO=ghcr.io/icem0/bma-lager

# ---------- Ports am Host ----------
# API und PWA werden direkt am Host exponiert (Default-Ports unten).
# Falls du einen Reverse-Proxy davorschaltest, kann er auf diese Ports mappen.
# Intern laufen die Container auf 3000 (API) und 80 (PWA) — die Host-Ports
# sind hier konfigurierbar.
API_PORT=4242
PWA_PORT=4280

# ---------- Datenbank ----------
DB_NAME=bma
DB_USER=bma
# Starkes Passwort, mind. 16 Zeichen, generiert z. B. mit `openssl rand -base64 24`
DB_PASSWORD=

# ---------- Auth ----------
# JWT_SECRET: mindestens 64 Zeichen, z. B. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD: muss beim ersten Login geändert werden (mustChangePassword=true)
ADMIN_PASSWORD=

# Cookie-Domain — Domain, unter der die PWA tatsächlich läuft (OHNE Protokoll).
# Bei lokalem Test ohne Domain: COOKIE_DOMAIN=localhost
COOKIE_DOMAIN=localhost

# CORS-Origin der PWA (WO der Browser tatsächlich läuft)
# Lokal: CORS_ORIGIN=http://localhost:4280
# Hinter eigenem Reverse-Proxy: CORS_ORIGIN=https://deine-domain.example
CORS_ORIGIN=http://localhost:4280

# Setze COOKIE_SECURE=true wenn die PWA über HTTPS erreichbar ist
# (setzt das Secure-Flag auf dem Refresh-Cookie).
COOKIE_SECURE=false

# ---------- Foto-Limits ----------
FOTOS_MAX_BYTES=524288       # 512 kB pro Datei
FOTOS_MAX_PER_ARTIKEL=5

# ---------- Rate-Limit ----------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=1 minute

# ---------- Logging ----------
LOG_LEVEL=info